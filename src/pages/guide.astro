            <tr><th>命令</th><th>作用</th></tr>
          </thead>
          <tbody>
            <tr><td><code>/plot auto</code></td><td>自动领取一块空闲地皮</td></tr>
            <tr><td><code>/plot home</code></td><td>返回自己的地皮</td></tr>
            <tr><td><code>/plot list</code></td><td>查看自己的地皮</td></tr>
            <tr><td><code>/plot add &lt;玩家&gt;</code></td><td>添加共同建造成员</td></tr>
            <tr><td><code>/plot remove &lt;玩家&gt;</code></td><td>移除成员</td></tr>
