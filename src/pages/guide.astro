---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CopyButton from '../components/CopyButton.astro';
import { site } from '../data/site';
import { guideSearchIndex } from '../data/guide-search';
---

<BaseLayout
  title="游玩指南 · 33生存"
  description="33生存游玩指南：进服、领地、地皮、菜单、强化、副本、通行证、兑换、灵魂绑定、超级熔炉、蟠桃、经验挂机池和排行榜。"
>
  <div class="guide-shell" data-guide-shell>
    <aside class="guide-sidebar">
      <div class="guide-sidebar-inner">
        <a class="guide-brand" href="/">
          <span class="guide-brand-mark">33</span>
          <span class="guide-brand-text">33生存<small>游玩指南</small></span>
        </a>

        <p class="guide-sidebar-title">目录</p>
        <nav aria-label="指南目录">
          <p class="guide-nav-label">开始</p>
          <a href="#start" class="is-active">进服</a>

          <p class="guide-nav-label">常用指令</p>
          <a href="#commands-common" data-command-link>常用</a>
          <a href="#commands-auth" data-command-link>账号</a>
          <a href="#commands-basic" data-command-link>基础</a>
          <a href="#commands-teleport" data-command-link>传送</a>
          <a href="#commands-economy" data-command-link>经济商店</a>
          <a href="#commands-social" data-command-link>技能公会</a>
          <a href="#commands-welfare" data-command-link>福利外观</a>
          <a href="#commands-other" data-command-link>其他</a>

          <p class="guide-nav-label">世界</p>
          <a href="#residence">领地</a>
          <a href="#plot">地皮</a>

          <p class="guide-nav-label">玩法</p>
          <a href="#menu">菜单</a>
          <a href="#enhance">强化</a>
          <a href="#dungeon">副本</a>
          <a href="#pass">通行证</a>
          <a href="#redeem">兑换</a>
          <a href="#soulbound">灵魂绑定</a>
          <a href="#furnace">超级熔炉</a>
          <a href="#peach">蟠桃</a>
          <a href="#exppond">挂机池</a>
          <a href="#top">排行榜</a>

          <p class="guide-nav-label">其他</p>
          <a href="#faq">FAQ</a>
        </nav>

        <div class="guide-sidebar-group">
          <span>QQ 群</span>
          <a href={site.qqGroupLink} target="_blank" rel="noreferrer"><code>{site.qqGroup}</code></a>
          <small>点击群号直接加群</small>
        </div>

        <a class="guide-sidebar-cta" href="/download">
          下载启动器
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </aside>

    <div class="guide-backdrop" data-guide-backdrop></div>

    <div class="guide-main">
      <div class="guide-toolbar">
        <button
          class="guide-menu-toggle icon-button"
          type="button"
          data-guide-menu
          aria-label="打开目录"
          aria-expanded="false"
        >
          <Icon name="menu" size={18} />
        </button>

        <div class="guide-search" data-guide-search-wrap>
          <Icon name="search" size={16} />
          <input
            type="search"
            placeholder="搜索指南内容…"
            aria-label="搜索指南"
            autocomplete="off"
            data-guide-search
          />
          <span class="guide-search-hint">Ctrl K</span>
          <div class="guide-search-results" data-guide-results hidden></div>
        </div>

        <a class="guide-toolbar-link" href="/">返回首页</a>
      </div>

      <div class="guide-content">
        <header class="guide-heading" data-reveal>
          <p class="eyebrow"><span class="eyebrow-dot"></span>GUIDE</p>
          <h1>游玩指南</h1>
          <p>
            从进服、领地、地皮、菜单、强化，到副本、通行证、兑换和挂机池，一页看完。只收录玩家能用的命令，管理指令不放在这里。
          </p>
          <div class="guide-heading-actions">
            <a class="button button-primary" href="/#join">
              加入服务器
              <Icon name="arrow" size={18} />
            </a>
            <a class="button button-ghost" href="#commands-common">常用指令</a>
            <a class="button button-ghost" href="/download">下载启动器</a>
          </div>
        </header>

        <section class="guide-section" data-reveal id="start">
      <p class="eyebrow"><span class="eyebrow-dot"></span>START</p>
      <h2>进入服务器</h2>
      <p class="guide-lead">Java 版 1.21.11，原版客户端，无额外要求。</p>

      <div class="join-ip">
        <span>服务器地址</span>
        <code>mc33.top</code>
        <CopyButton value="mc33.top" label="复制地址" />
      </div>

      <ol class="steps">
        <li>
          <span class="step-num">01</span>
          <h3>启动游戏</h3>
          <p>Minecraft Java 版 {site.version}。</p>
        </li>
        <li>
          <span class="step-num">02</span>
          <h3>添加服务器</h3>
          <p>地址填写 mc33.top。</p>
        </li>
        <li>
          <span class="step-num">03</span>
          <h3>进入世界</h3>
          <p>不需要安装模组，直接进。</p>
        </li>
      </ol>

      <div class="start-actions">
        <a class="button button-primary" href="/download">
          下载启动器
          <Icon name="arrow" size={18} />
        </a>
      </div>
    </section>

    <section class="guide-section" data-reveal id="commands">
      <p class="eyebrow"><span class="eyebrow-dot"></span>QUICK COMMANDS</p>
      <h2>指令速查</h2>
      <p class="guide-lead">
        从左侧目录选择分类。这里只收玩家命令；领地、地皮、副本的完整教程在下面章节。
      </p>

      <div class="command-panels">
      <div class="command-panel is-active" id="commands-common" role="tabpanel" data-command-panel="common">
        <h3>常用</h3>
        <div class="command-table-wrap">
          <table class="command-table">
            <thead><tr><th>命令</th><th>作用</th></tr></thead>
            <tbody>
              <tr><td><code>/cd</code></td><td>打开主菜单</td></tr>
              <tr><td><code>/spawn</code></td><td>回出生点</td></tr>
              <tr><td><code>/sethome</code> / <code>/home</code></td><td>设置家/回家</td></tr>
              <tr><td><code>/tpa &lt;玩家&gt;</code></td><td>请求传送到对方</td></tr>
              <tr><td><code>/tpaccept</code></td><td>接受传送请求</td></tr>
              <tr><td><code>/pay &lt;玩家&gt; &lt;金额&gt;</code></td><td>转账</td></tr>
              <tr><td><code>/balance</code></td><td>查看余额</td></tr>
              <tr><td><code>/shop</code></td><td>系统商店</td></tr>
              <tr><td><code>/qs</code></td><td>箱子商店帮助</td></tr>
              <tr><td><code>/pm open</code></td><td>全球玩家市场</td></tr>
              <tr><td><code>/res tp &lt;领地名&gt;</code></td><td>传送到领地</td></tr>
              <tr><td><code>/plot home</code></td><td>回自己的地皮</td></tr>
              <tr><td><code>/esystem open</code></td><td>打开强化面板</td></tr>
              <tr><td><code>/cdm menu</code></td><td>副本主菜单</td></tr>
              <tr><td><code>/psi</code></td><td>每日签到</td></tr>
              <tr><td><code>/crate</code></td><td>抽奖箱</td></tr>
              <tr><td><code>/plt</code></td><td>称号界面</td></tr>
            </tbody>
          </table>
        </div>
        <div class="note-box"><strong>提示：</strong>下面是分类；领地、地皮、副本、兑换、灵魂绑定等完整说明在后续章节。</div>
      </div>

      <div class="command-panel" id="commands-auth" role="tabpanel" data-command-panel="auth">
        <h3>账号登录</h3>
        <p class="guide-lead">
          账号登录在启动器/登录入口完成，进入服务器后不需要在聊天栏输入任何登录或注册命令。
        </p>
        <div class="guide-grid">
          <article class="guide-card">
            <h3>首次进入</h3>
            <ol>
              <li>打开启动器，注册或登录账号</li>
              <li>启动 Minecraft Java 版 1.21.11</li>
              <li>添加服务器 mc33.top 并进入</li>
              <li>进入后直接开始游玩，不用在聊天栏输密码</li>
            </ol>
          </article>
          <article class="guide-card">
            <h3>提示未登录 / 账号异常</h3>
            <ul>
              <li>退出启动器，重新登录账号</li>
              <li>确认启动器和游戏使用的是同一个账号</li>
              <li>仍然进不去就在群里反馈，附上报错截图</li>
              <li>不要在游戏聊天栏里发密码</li>
            </ul>
          </article>
        </div>
        <div class="note-box"><strong>说明：</strong>游戏内不再有注册/登录命令。登录问题在启动器或登录页面解决。</div>
      </div>

      <div class="command-panel" id="commands-basic" role="tabpanel" data-command-panel="basic">
        <h3>基础、家与工具</h3>
        <div class="command-table-wrap">
          <table class="command-table">
            <thead><tr><th>命令</th><th>作用</th></tr></thead>
            <tbody>
              <tr><td><code>/spawn</code> / <code>/back</code></td><td>出生点/回上次位置</td></tr>
              <tr><td><code>/home [名字]</code> / <code>/sethome [名字]</code></td><td>回家/设置家</td></tr>
              <tr><td><code>/delhome [名字]</code> / <code>/homes</code></td><td>删家/家列表</td></tr>
              <tr><td><code>/warp [名字]</code> / <code>/warps</code></td><td>服务器地标/列表</td></tr>
              <tr><td><code>/top</code> / <code>/jump</code> / <code>/thru</code></td><td>到最高点/跳上/穿墙</td></tr>
              <tr><td><code>/unstuck</code></td><td>移出卡住位置</td></tr>
              <tr><td><code>/balance</code> / <code>/pay &lt;玩家&gt; &lt;金额&gt;</code></td><td>余额/转账</td></tr>
              <tr><td><code>/baltop</code> / <code>/cheque &lt;金额&gt;</code></td><td>财富榜/支票</td></tr>
              <tr><td><code>/msg &lt;玩家&gt; &lt;消息&gt;</code> / <code>/reply &lt;消息&gt;</code></td><td>私聊/回复</td></tr>
              <tr><td><code>/mail</code> / <code>/ignore &lt;玩家&gt;</code></td><td>邮件/屏蔽</td></tr>
              <tr><td><code>/afk</code> / <code>/near</code> / <code>/list</code></td><td>暂离/附近/在线列表</td></tr>
              <tr><td><code>/ping</code> / <code>/playtime</code> / <code>/seen &lt;玩家&gt;</code></td><td>延迟/在线时长/最后在线</td></tr>
              <tr><td><code>/kit</code> / <code>/kits</code></td><td>套件</td></tr>
              <tr><td><code>/anvil</code> / <code>/workbench</code> / <code>/enderchest</code></td><td>铁砧/工作台/末影箱</td></tr>
              <tr><td><code>/craft</code> / <code>/trash</code> / <code>/hat</code></td><td>合成/垃圾桶/戴帽子</td></tr>
              <tr><td><code>/sit</code> / <code>/lay</code> / <code>/head</code></td><td>坐下/躺下/头颅</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="command-panel" id="commands-teleport" role="tabpanel" data-command-panel="teleport">
        <h3>传送请求</h3>
        <div class="command-table-wrap">
          <table class="command-table">
            <thead><tr><th>命令</th><th>作用</th></tr></thead>
            <tbody>
              <tr><td><code>/tpa &lt;玩家&gt;</code></td><td>请求传送到对方</td></tr>
              <tr><td><code>/tpahere &lt;玩家&gt;</code></td><td>请求对方传送到你</td></tr>
              <tr><td><code>/tpaccept [玩家]</code> / <code>/tpdeny [玩家]</code></td><td>接受/拒绝</td></tr>
              <tr><td><code>/tpcancel [玩家]</code></td><td>取消自己发出的请求</td></tr>
              <tr><td><code>/tptoggle</code></td><td>开关接收请求</td></tr>
            </tbody>
          </table>
        </div>

        <h3>玩家地标</h3>
        <div class="command-table-wrap">
          <table class="command-table">
            <thead><tr><th>命令</th><th>作用</th></tr></thead>
            <tbody>
              <tr><td><code>/plw</code></td><td>打开玩家地标界面</td></tr>
              <tr><td><code>/plw list</code></td><td>地标列表</td></tr>
              <tr><td><code>/plw tp &lt;地标&gt;</code></td><td>传送到地标</td></tr>
              <tr><td><code>/plw create &lt;名字&gt;</code></td><td>创建地标</td></tr>
              <tr><td><code>/plw delete &lt;名字&gt;</code></td><td>删除自己的地标</td></tr>
            </tbody>
          </table>
        </div>

        <h3>随机传送</h3>
        <div class="command-table-wrap">
          <table class="command-table">
            <thead><tr><th>命令</th><th>作用</th></tr></thead>
            <tbody>
              <tr><td><code>/rtp</code></td><td>随机传送到安全位置（别名 /yurtp）</td></tr>
              <tr><td><code>/rtp help</code></td><td>查看帮助</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="command-panel" id="commands-economy" role="tabpanel" data-command-panel="economy">
        <h3>系统商店</h3>
        <div class="command-table-wrap">
          <table class="command-table">
            <thead><tr><th>命令</th><th>作用</th></tr></thead>
            <tbody>
              <tr><td><code>/shop</code></td><td>打开系统商店</td></tr>
              <tr><td><code>/shop &lt;分类&gt;</code></td><td>打开指定分类</td></tr>
              <tr><td><code>/shop search &lt;物品&gt;</code></td><td>搜索商品</td></tr>
              <tr><td><code>/sell</code></td><td>一键出售可卖物品</td></tr>
            </tbody>
          </table>
        </div>

        <h3>箱子商店</h3>
        <div class="command-table-wrap">
          <table class="command-table">
            <thead><tr><th>命令</th><th>作用</th></tr></thead>
            <tbody>
              <tr><td><code>/qs</code></td><td>商店帮助（别名 /chestshop、/cshop）</td></tr>
              <tr><td><code>/qs create &lt;价格&gt;</code></td><td>看着箱子创建商店</td></tr>
              <tr><td><code>/qs buy</code> / <code>/qs sell</code></td><td>切换收购/出售模式</td></tr>
              <tr><td><code>/qs price &lt;价格&gt;</code> / <code>/qs amount &lt;数量&gt;</code></td><td>改价格/交易数量</td></tr>
              <tr><td><code>/qs find &lt;物品&gt;</code></td><td>搜索附近商店</td></tr>
              <tr><td><code>/qs info</code> / <code>/qs remove</code></td><td>查看/删除商店</td></tr>
              <tr><td><code>/qs transfer &lt;玩家&gt;</code></td><td>转让商店</td></tr>
              <tr><td><code>/qs history</code> / <code>/qs income</code></td><td>交易记录/收入</td></tr>
              <tr><td><code>/qs item</code> / <code>/qs size</code> / <code>/qs benefit</code></td><td>商品/容量/收益</td></tr>
              <tr><td><code>/qs lock</code> / <code>/qs freeze</code></td><td>锁定/冻结商店</td></tr>
            </tbody>
          </table>
        </div>

        <h3>全球市场</h3>
        <div class="command-table-wrap">
          <table class="command-table">
            <thead><tr><th>命令</th><th>作用</th></tr></thead>
            <tbody>
              <tr><td><code>/pm open</code></td><td>打开全球市场（别名 /spm、/playermarket）</td></tr>
              <tr><td><code>/pm me</code></td><td>查看自己上架的商品</td></tr>
              <tr><td><code>/pm tags [玩家]</code></td><td>按分类浏览</td></tr>
              <tr><td><code>/pm create &lt;类型&gt; &lt;价格&gt; &lt;货币&gt; [单份数量] [总份数]</code></td><td>上架主手物品</td></tr>
              <tr><td><code>/pm create &lt;类型&gt; --menu</code></td><td>打开上架菜单</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="command-panel" id="commands-social" role="tabpanel" data-command-panel="social">
        <h3>技能</h3>
        <div class="command-table-wrap">
          <table class="command-table">
            <thead><tr><th>命令</th><th>作用</th></tr></thead>
            <tbody>
              <tr><td><code>/mcstats</code> / <code>/mctop</code> / <code>/mcrank</code></td><td>技能/排行/自己的排名</td></tr>
              <tr><td><code>/mmopower</code> / <code>/mcability</code></td><td>总能力/开关技能</td></tr>
              <tr><td><code>/mccooldown</code> / <code>/mcnotify</code></td><td>冷却/提示</td></tr>
              <tr><td><code>/party</code> / <code>/ptp</code> / <code>/partychat</code></td><td>队伍/传送/队伍聊天</td></tr>
              <tr><td><code>/mining</code> / <code>/woodcutting</code> / <code>/excavation</code></td><td>查看对应技能</td></tr>
              <tr><td><code>/herbalism</code> / <code>/fishing</code> / <code>/repair</code></td><td>查看对应技能</td></tr>
              <tr><td><code>/swords</code> / <code>/axes</code> / <code>/archery</code></td><td>查看战斗技能</td></tr>
            </tbody>
          </table>
        </div>

        <h3>公会</h3>
        <div class="command-table-wrap">
          <table class="command-table">
            <thead><tr><th>命令</th><th>作用</th></tr></thead>
            <tbody>
              <tr><td><code>/plg</code> / <code>/plg</code></td><td>打开公会界面</td></tr>
              <tr><td><code>/plg create &lt;名称&gt;</code> / <code>invite &lt;玩家&gt;</code></td><td>创建/邀请</td></tr>
              <tr><td><code>/plg accept &lt;公会&gt;</code> / <code>leave</code></td><td>接受/离开</td></tr>
              <tr><td><code>/plg info</code> / <code>list</code> / <code>chat</code></td><td>信息/列表/聊天</td></tr>
              <tr><td><code>/plg home</code> / <code>sethome</code></td><td>公会家</td></tr>
              <tr><td><code>/plg deposit &lt;金额&gt;</code> / <code>withdraw &lt;金额&gt;</code></td><td>公会资金</td></tr>
            </tbody>
          </table>
        </div>

        <h3>悬赏</h3>
        <div class="command-table-wrap">
          <table class="command-table">
            <thead><tr><th>命令</th><th>作用</th></tr></thead>
            <tbody>
              <tr><td><code>/notbounties</code></td><td>打开悬赏界面/主命令</td></tr>
              <tr><td><code>/notbounties list</code> / <code>info &lt;玩家&gt;</code></td><td>查看悬赏</td></tr>
              <tr><td><code>/notbounties place &lt;玩家&gt; &lt;金额&gt;</code></td><td>挂悬赏</td></tr>
              <tr><td><code>/notbounties cancel &lt;玩家&gt;</code></td><td>取消自己挂的悬赏</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="command-panel" id="commands-welfare" role="tabpanel" data-command-panel="welfare">
        <h3>签到、抽奖、在线奖励、邀请</h3>
        <div class="command-table-wrap">
          <table class="command-table">
            <thead><tr><th>功能</th><th>命令</th><th>作用</th></tr></thead>
            <tbody>
              <tr><td>每日签到</td><td><code>/psi</code> / <code>/psi</code></td><td>每日签到</td></tr>
              <tr><td>抽奖箱</td><td><code>/crate</code> / <code>/fc</code></td><td>抽奖箱界面</td></tr>
              <tr><td>抽奖箱</td><td><code>/crate open &lt;箱子&gt;</code></td><td>用钥匙开指定抽奖箱</td></tr>
              <tr><td>在线奖励</td><td><code>/lr</code> / <code>/liur</code></td><td>在线奖励界面</td></tr>
              <tr><td>邀请</td><td><code>/invite</code></td><td>邀请系统界面</td></tr>
              <tr><td>邀请</td><td><code>/invite list</code> / <code>bind &lt;玩家&gt;</code></td><td>邀请列表/绑定关系</td></tr>
              <tr><td>通行证</td><td><code>/pass</code> / <code>/arcpass</code> / <code>/cypass</code></td><td>通行证主界面</td></tr>
              <tr><td>通行证</td><td><code>/cypass quests|rewards|shop|claim|season</code></td><td>任务/奖励/商店/领取</td></tr>
            </tbody>
          </table>
        </div>

        <h3>外观、钓鱼与附魔</h3>
        <div class="command-table-wrap">
          <table class="command-table">
