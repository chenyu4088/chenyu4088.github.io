  <script type="application/json" id="guide-search-index" set:html={JSON.stringify(guideSearchIndex)}></script>

  <script is:inline>
    (() => {
      const shell = document.querySelector('[data-guide-shell]');
      const menu = document.querySelector('[data-guide-menu]');

      const setSidebar = (open) => {
        if (shell) shell.classList.toggle('sidebar-open', open);
        if (menu) {
          menu.setAttribute('aria-expanded', String(open));
          menu.setAttribute('aria-label', open ? '关闭目录' : '打开目录');
        }
      };

      menu?.addEventListener('click', () => {
        setSidebar(!shell?.classList.contains('sidebar-open'));
      });

      document.querySelector('[data-guide-backdrop]')?.addEventListener('click', () => {
        setSidebar(false);
      });

      document.querySelectorAll('.guide-sidebar a').forEach((link) => {
        link.addEventListener('click', () => setSidebar(false));
      });

      const commandLinks = Array.from(document.querySelectorAll('[data-command-link]'));
      const commandPanels = Array.from(document.querySelectorAll('[data-command-panel]'));

      const showCommandCategory = (id) => {
        commandPanels.forEach((panel) => {
          panel.classList.toggle('is-active', panel.id === id);
        });
        commandLinks.forEach((link) => {
          link.classList.toggle('is-active', link.getAttribute('href') === `#${id}`);
        });
      };

      commandLinks.forEach((link) => {
        link.addEventListener('click', (event) => {
          const id = (link.getAttribute('href') || '').replace('#', '');
          if (!id) return;
          event.preventDefault();
          showCommandCategory(id);
          document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${id}`);
        });
      });

      if (location.hash.startsWith('#commands-')) {
        showCommandCategory(location.hash.slice(1));
      }

      const links = Array.from(
        document.querySelectorAll('.guide-sidebar nav a:not([data-command-link])')
      );
      const sections = links.map((link) => {
        const href = link.getAttribute('href');
        return href ? document.querySelector(href) : null;
      });

      if (links.length && sections.some(Boolean)) {
        const setActive = (index) => {
          links.forEach((link, i) => {
            const active = i === index;
            link.classList.toggle('is-active', active);
            if (active) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        };

        const header = document.querySelector('.site-header');
        const toolbar = document.querySelector('.guide-toolbar');

        const updateActive = () => {
          const offset = (header?.offsetHeight ?? 72) + (toolbar?.offsetHeight ?? 0) + 24;
          let current = 0;
          sections.forEach((section, index) => {
            if (section && section.getBoundingClientRect().top <= offset) current = index;
          });
          setActive(current);
        };

        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            updateActive();
            ticking = false;
          });
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        window.addEventListener('hashchange', updateActive);
        updateActive();
      }

      const input = document.querySelector('[data-guide-search]');
      const results = document.querySelector('[data-guide-results]');
      if (!input || !results) return;

      results.addEventListener('click', (event) => {
        const link = event.target.closest?.('a');
        if (link?.getAttribute('href') === '#commands') {
          showCommandCategory('commands-common');
        }
      });

      let extraIndex = [];
      const indexElement = document.getElementById('guide-search-index');
      if (indexElement) {
        try {
          extraIndex = JSON.parse(indexElement.textContent || '[]');
        } catch {
          extraIndex = [];
        }
      }

      const items = Array.from(document.querySelectorAll('.guide-content .guide-section')).map(
        (section) => {
          const extra = extraIndex.find((item) => item.section === section.id);
          const hiddenText = extra
            ? [extra.keywords?.join(' '), extra.commands?.join(' ')].filter(Boolean).join(' ')
            : '';

          return {
            id: section.id,
            title: section.querySelector('h2')?.textContent?.trim() || section.id,
            text: [section.textContent, hiddenText]
              .filter(Boolean)
              .join(' ')
              .replace(/\s+/g, ' ')
              .trim(),
          };
        }
      );

      const render = () => {
        const query = input.value.trim().toLowerCase();
        if (!query) {
          results.hidden = true;
          results.replaceChildren();
          return;
        }

        const matches = items
          .filter((item) => item.title.toLowerCase().includes(query) || item.text.toLowerCase().includes(query))
          .slice(0, 8);

        results.replaceChildren();
        results.hidden = false;

        if (!matches.length) {
          const empty = document.createElement('div');
          empty.className = 'guide-search-empty';
          empty.textContent = '没有找到相关内容';
          results.append(empty);
          return;
        }

        matches.forEach((item) => {
          const link = document.createElement('a');
          link.href = `#${item.id}`;

          const title = document.createElement('span');
          title.className = 'guide-result-title';
          title.textContent = item.title;

          const meta = document.createElement('span');
          meta.className = 'guide-result-meta';
          meta.textContent = '跳转到该章节';

          link.append(title, meta);
          link.addEventListener('click', () => {
            results.hidden = true;
            input.value = '';
            setSidebar(false);
          });
          results.append(link);
        });
      };

      input.addEventListener('input', render);
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          const first = results.querySelector('a');
          if (first) first.click();
        }
        if (event.key === 'Escape') {
          results.hidden = true;
          input.blur();
        }
      });

      document.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          input.focus();
          input.select();
        }
      });

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        if (!event.target.closest('[data-guide-search-wrap]')) results.hidden = true;
      });
    })();
  </script>
</BaseLayout>
